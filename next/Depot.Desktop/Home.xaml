<Window x:Class="Depot.Desktop.Home" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BMS Depot" Width="1080" Height="820" MinWidth="900" MinHeight="720" Background="#F3F5F9" WindowStartupLocation="CenterScreen" Closing="ClosingWindow">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DFEB"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/></Style>
 </Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><DockPanel><Button Content="사용 방법" Click="ShowHelp" DockPanel.Dock="Right" VerticalAlignment="Top"/><StackPanel><TextBlock Text="BMS Depot" FontSize="29" FontWeight="Bold" Foreground="#192A43"/><TextBlock Text="필요한 곡을 받아, 평소 쓰던 게임에서 플레이하세요." Foreground="#64718A" Margin="0,4,0,14"/></StackPanel></DockPanel>
   <Border Background="#E8EEFF" CornerRadius="10" Padding="14" Margin="0,0,0,16"><DockPanel><Button Content="게임에 폴더 등록" Click="ShowFolderHelp" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="SetupHint" Text="처음 한 번 다운로드 폴더를 게임에 등록해주세요." VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#294773"/></DockPanel></Border>
  </StackPanel>
  <StackPanel Grid.Row="1"><DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Left" Width="205" Margin="0,0,12,0"><TextBlock Text="난이도표" Foreground="#64718A" Margin="0,0,0,5"/><ComboBox x:Name="TableBox" SelectionChanged="TableChanged" Padding="8"/></StackPanel><CheckBox x:Name="InstalledOnly" Content="가지고 있는 곡만" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="12,0,0,10" Checked="FilterChanged" Unchecked="FilterChanged"/><StackPanel><TextBlock Text="곡 찾기" Foreground="#64718A" Margin="0,0,0,5"/><Grid><TextBox x:Name="Search" TextChanged="SearchChanged"/><TextBlock Text="곡 이름 또는 아티스트를 입력하세요" IsHitTestVisible="False" Foreground="#8591A4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel></DockPanel>
   <Expander Header="이미 가지고 있는 곡 등록하기" Margin="0,0,0,8"><StackPanel Margin="0,10,0,6"><TextBlock Text="사용하던 BMS 폴더를 고르면 보유곡을 찾아줍니다. 원본은 옮기거나 삭제하지 않습니다." Foreground="#64718A" TextWrapping="Wrap" Margin="0,0,0,8"/><WrapPanel><Button x:Name="AddExistingButton" Content="사용하던 곡 폴더 선택" Click="AddExistingFolder"/><Button x:Name="RescanButton" Content="등록한 폴더 다시 확인" Click="RescanExisting" Margin="8,0,0,0"/><Button x:Name="OpenExistingButton" Content="선택한 곡의 원래 폴더 열기" Click="OpenExistingFolder" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="ExistingSummary" Foreground="#64718A" Margin="0,8,0,0"/></StackPanel></Expander>
   <TextBlock x:Name="Summary" Foreground="#64718A" Margin="0,0,0,8"/>
  </StackPanel>
  <DataGrid Grid.Row="2" x:Name="Songs" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" SelectionChanged="SongChanged" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="Horizontal" BorderBrush="#E1E6EF" Background="White">
   <DataGrid.Columns><DataGridTextColumn Header="곡 이름" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="아티스트" Binding="{Binding Artist}" Width="170"/><DataGridTextColumn Header="난이도표 / 레벨" Binding="{Binding Level}" Width="160"/><DataGridTextColumn Header="내 곡" Binding="{Binding State}" Width="110"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0"><DockPanel><Button x:Name="DownloadButton" Content="곡을 선택하세요" Click="DownloadSong" Background="#265DEA" Foreground="White" DockPanel.Dock="Right" Padding="22,12" FontSize="15"/><Button x:Name="CancelButton" Content="작업 중단" Click="CancelDownload" DockPanel.Dock="Right" Visibility="Collapsed" Margin="0,0,8,0"/><StackPanel><TextBlock x:Name="SelectedTitle" Text="목록에서 받고 싶은 곡을 누르세요." TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="Ctrl·Shift를 누르고 선택하면 여러 곡을 한 번에 받을 수 있습니다." Foreground="#64718A" FontSize="12" Margin="0,5,10,0"/></StackPanel></DockPanel>
   <ProgressBar x:Name="Progress" Height="6" Margin="0,12,0,0" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="곡 목록을 준비하고 있습니다…" TextWrapping="Wrap" Margin="0,10,0,0"/>
   <Border x:Name="AfterDownload" Visibility="Collapsed" Background="#E7F4ED" Padding="12" CornerRadius="8" Margin="0,8,0,0"><DockPanel><Button Content="게임에서 찾는 방법" Click="ShowPlayHelp" DockPanel.Dock="Right"/><TextBlock x:Name="AfterHint" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#285940" Margin="0,0,12,0"/></DockPanel></Border>
   <Expander x:Name="ErrorPanel" Header="받지 못한 곡과 자세한 이유" Visibility="Collapsed" Margin="0,6,0,0"><TextBox x:Name="Error" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"/></Expander>
  </StackPanel>
  <Expander Grid.Row="4" Header="저장 공간과 폴더 관리" Margin="0,14,0,0"><ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="Storage" Margin="0,0,0,8"/><WrapPanel><TextBlock Text="Depot가 보관할 용량 (GiB)" VerticalAlignment="Center"/><TextBox x:Name="Capacity" Width="55" Margin="8,0,16,0"/><TextBlock Text="보관 기간 (일)" VerticalAlignment="Center"/><TextBox x:Name="Days" Width="55" Margin="8,0"/><Button x:Name="SaveButton" Content="설정 저장" Click="SaveSettings"/></WrapPanel><TextBlock Text="직접 등록한 기존 곡은 삭제하지 않습니다. Depot가 받은 곡만 최근 다운로드·확인 시점을 기준으로 정리합니다." TextWrapping="Wrap" Foreground="#64718A" FontSize="12" Margin="0,8,0,12"/>
   <TextBlock Text="다운로드 폴더" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,8"><Button Content="주소 복사" Click="CopyFolder" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="열기" Click="OpenManagedFolder" DockPanel.Dock="Right"/><TextBox x:Name="ManagedFolder" IsReadOnly="True"/></DockPanel><WrapPanel><Button x:Name="RefreshButton" Content="보유 여부 다시 확인" Click="RefreshLibrary"/><Button x:Name="OrganizeButton" Content="예전에 받은 곡을 레벨별로 정리" Click="OrganizeLibrary" Margin="8,0,0,0"/></WrapPanel>
  </StackPanel></ScrollViewer></Expander>
 </Grid>
</Window>
