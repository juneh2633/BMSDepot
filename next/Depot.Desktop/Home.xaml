<Window x:Class="Depot.Desktop.Home" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BMS Depot" Width="1040" Height="800" MinWidth="820" MinHeight="650" Background="#F2F4F8" WindowStartupLocation="CenterScreen" Closing="ClosingWindow">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="16,9"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/></Style></Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="BMS Depot" FontSize="30" FontWeight="Bold"/><TextBlock Text="여기서 다운로드하고, LR2·OpenLR2의 곡 목록을 갱신하세요." Foreground="#64718A" Margin="0,6,0,14"/>
   <TextBlock Text="게임에 등록할 난이도표·레벨별 곡 폴더" FontWeight="SemiBold"/>
   <DockPanel Margin="0,6,0,16"><Button Content="경로 복사" DockPanel.Dock="Right" Click="CopyFolder" Margin="8,0,0,0"/><Button Content="폴더 열기" DockPanel.Dock="Right" Click="OpenManagedFolder"/><Button x:Name="RefreshButton" Content="설치 상태 갱신" DockPanel.Dock="Right" Click="RefreshLibrary" Margin="0,0,8,0"/><TextBox x:Name="ManagedFolder" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
  </StackPanel>
  <StackPanel Grid.Row="1"><WrapPanel Margin="0,0,0,8"><Button x:Name="AddExistingButton" Content="기존 곡 폴더 추가" Click="AddExistingFolder"/><Button x:Name="RescanButton" Content="다시 검색" Click="RescanExisting" Margin="8,0,0,0"/><Button x:Name="OpenExistingButton" Content="선택한 보유곡 폴더 열기" Click="OpenExistingFolder" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="ExistingSummary" Foreground="#64718A" Margin="0,0,0,8"/><Button x:Name="OrganizeButton" Content="기존 설치곡을 난이도 폴더로 정리" Click="OrganizeLibrary" HorizontalAlignment="Left" Margin="0,0,0,10"/><DockPanel><ComboBox x:Name="TableBox" Width="200" DockPanel.Dock="Left" SelectionChanged="TableChanged" Padding="8" Margin="0,0,10,0"/><CheckBox x:Name="InstalledOnly" Content="설치된 곡만" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Checked="FilterChanged" Unchecked="FilterChanged"/><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="곡명 또는 아티스트 검색"/></DockPanel><TextBlock x:Name="Summary" Foreground="#64718A" Margin="0,8,0,8"/></StackPanel>
  <DataGrid Grid.Row="2" x:Name="Songs" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" SelectionChanged="SongChanged" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="34" Background="White">
   <DataGrid.Columns><DataGridTextColumn Header="곡명" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="아티스트" Binding="{Binding Artist}" Width="180"/><DataGridTextColumn Header="난이도표 · 레벨" Binding="{Binding Level}" Width="170"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="110"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Ctrl 또는 Shift를 누르고 선택하면 여러 곡을 순서대로 받습니다." Foreground="#64718A" FontSize="12" Margin="0,0,0,8"/><DockPanel><Button x:Name="DownloadButton" Content="선택한 곡 다운로드" Click="DownloadSong" Background="#265DEA" Foreground="White" DockPanel.Dock="Right"/><Button x:Name="CancelButton" Content="작업 취소" Click="CancelDownload" DockPanel.Dock="Right" Visibility="Collapsed" Margin="0,0,8,0"/><TextBlock x:Name="SelectedTitle" Text="목록에서 곡을 선택하세요." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/></DockPanel>
   <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,0" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="목록을 불러옵니다…" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <Expander x:Name="ErrorPanel" Header="오류 내용" Visibility="Collapsed"><TextBox x:Name="Error" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto"/></Expander>
  </StackPanel>
  <Expander Grid.Row="4" Header="저장 공간 · 보관 설정" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="Storage" Margin="0,8,0,8"/><WrapPanel><TextBlock Text="용량 (GiB)" VerticalAlignment="Center"/><TextBox x:Name="Capacity" Width="55" Margin="8,0,16,0"/><TextBlock Text="보관 기간 (일)" VerticalAlignment="Center"/><TextBox x:Name="Days" Width="55" Margin="8,0"/><Button x:Name="SaveButton" Content="저장" Click="SaveSettings"/></WrapPanel><TextBlock Text="게임 실행 중 기존 곡은 자동 삭제하지 않습니다. 정리 기준은 최근 다운로드·설치 확인 시점입니다." TextWrapping="Wrap" Foreground="#64718A" FontSize="12" Margin="0,8,0,0"/></StackPanel></Expander>
 </Grid>
</Window>
